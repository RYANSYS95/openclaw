  <footer class="legal">
    <p><strong>Confidentiel – Projet. Ne pas diffuser.</strong> Les éléments et propositions inclus dans ce document sont des hypothèses de travail prospectives uniquement. Elles ne sont pas validées. Si certaines conséquences des initiatives contenues dans ce support donnaient lieu à des réorganisations ou transformations, elles feraient l'objet des procédures sociales adéquates (consultation des instances de représentation du Personnel).</p>
    <div class="ca-logo"><span class="mk">C<i>A</i></span><div>CRÉDIT AGRICOLE<br>GROUP INFRASTRUCTURE PLATFORM</div></div>
  </footer>
</section>

</main>

<div class="nav">
  <button id="prev" aria-label="Slide précédente">‹</button>
  <div class="dots"><span class="dot active" data-go="0"></span><span class="dot" data-go="1"></span></div>
  <button id="next" aria-label="Slide suivante">›</button>
</div>

<script>
  const slides=[...document.querySelectorAll('.slide')];
  const dots=[...document.querySelectorAll('.dot')];
  const tabs=[...document.querySelectorAll('.tab')];
  let i=0;
  function go(n){
    i=(n+slides.length)%slides.length;
    slides.forEach((s,k)=>s.classList.toggle('active',k===i));
    dots.forEach((d,k)=>d.classList.toggle('active',k===i));
    tabs.forEach((t,k)=>t.classList.toggle('active',k===i));
  }
  document.getElementById('prev').onclick=()=>go(i-1);
  document.getElementById('next').onclick=()=>go(i+1);
  [...dots,...tabs].forEach(el=>el.onclick=()=>go(+el.dataset.go));
  document.addEventListener('keydown',e=>{
    if(e.key==='ArrowRight')go(i+1);
    if(e.key==='ArrowLeft')go(i-1);
  });
  let x0=null;
  document.addEventListener('touchstart',e=>x0=e.touches[0].clientX,{passive:true});
  document.addEventListener('touchend',e=>{
    if(x0===null)return;const dx=e.changedTouches[0].clientX-x0;
    if(Math.abs(dx)>60)go(dx<0?i+1:i-1);x0=null;
  });
</script>
</body>
</html>
