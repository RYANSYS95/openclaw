<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Responsabilités partagées – CA-GIP</title>
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --navy:#12233d;
    --ink:#2b3a4a;
    --muted:#6b7c8a;
    --green:#00857c;      /* vert Crédit Agricole */
    --green-dark:#006a63;
    --sage:#7fa99b;       /* bloc CAGIP */
    --sage-dark:#5f8b7d;
    --blue:#1f6fb5;       /* bloc ENTITE */
    --blue-dark:#155692;
    --line:#c9d6d2;
    --paper:#ffffff;
    --bg:#eef3f1;
    --red:#e2001a;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  body{
    font-family:Inter,system-ui,sans-serif;color:var(--ink);
    background:radial-gradient(1200px 600px at 10% -10%,#dff0ea 0%,transparent 60%),
               radial-gradient(900px 500px at 110% 110%,#dde9f5 0%,transparent 60%),var(--bg);
    min-height:100vh;display:flex;flex-direction:column;align-items:center;
    padding:24px 16px 40px;
  }

  /* ---------- Top bar ---------- */
  .topbar{width:100%;max-width:1400px;display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:18px;flex-wrap:wrap}
  .brand{display:flex;align-items:center;gap:12px}
  .brand-mark{width:42px;height:42px;border-radius:12px;background:linear-gradient(135deg,var(--green),var(--green-dark));
    display:grid;place-items:center;color:#fff;font:800 16px Montserrat;letter-spacing:-.5px;box-shadow:0 6px 16px rgba(0,133,124,.3)}
  .brand-text{font:700 12px Montserrat;letter-spacing:1.2px;color:var(--navy);line-height:1.35;text-transform:uppercase}
  .brand-text span{display:block;color:var(--green)}
  .tabs{display:flex;gap:6px;background:#fff;padding:5px;border-radius:999px;box-shadow:0 4px 14px rgba(18,35,61,.08)}
  .tab{border:0;background:transparent;font:600 13px Inter;color:var(--muted);padding:9px 16px;border-radius:999px;cursor:pointer;transition:.2s}
  .tab.active{background:var(--navy);color:#fff}

  /* ---------- Slide ---------- */
  .stage{width:100%;max-width:1400px;position:relative}
  .slide{display:none;background:var(--paper);border-radius:22px;
    box-shadow:0 30px 60px -20px rgba(18,35,61,.25),0 2px 6px rgba(18,35,61,.06);
    padding:44px 48px 28px;position:relative;overflow:hidden;animation:fade .45s ease}
  .slide.active{display:block}
  @keyframes fade{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
  .slide::before{content:"";position:absolute;inset:0 0 auto 0;height:6px;
    background:linear-gradient(90deg,var(--green) 0%,var(--sage) 45%,var(--blue) 100%)}
  .slide-num{position:absolute;top:26px;right:32px;font:600 12px Inter;color:var(--muted);letter-spacing:1px}
  h1{font:800 clamp(24px,3vw,38px) Montserrat;color:var(--navy);letter-spacing:-.5px;margin-bottom:34px;max-width:80%}
  h1 em{font-style:normal;background:linear-gradient(90deg,var(--green),var(--blue));-webkit-background-clip:text;background-clip:text;color:transparent}

  .grid{display:grid;grid-template-columns:repeat(4,1fr);gap:22px}
  .col{display:flex;flex-direction:column;align-items:center;border-radius:16px;padding:18px 14px 20px;position:relative}
  .col:not(:last-child)::after{content:"";position:absolute;right:-11px;top:10%;bottom:10%;width:1px;background:linear-gradient(transparent,var(--line),transparent)}
  .col.dim{opacity:.55;filter:saturate(.6)}

  .pill{background:#f1f5f4;border:1px solid #e1e9e6;border-radius:12px;padding:10px 18px;text-align:center;
    font:700 14px Montserrat;color:var(--navy);line-height:1.3;min-width:170px}
  .pill small{display:block;font-size:14px;color:var(--green)}

  /* ---------- Diagram (slide 1) ---------- */
  .diagram{display:flex;align-items:stretch;justify-content:center;gap:12px;margin:14px 0 18px;width:100%;min-height:340px}
  .axis{display:flex;flex-direction:column;align-items:center}
  .arrows{display:flex;gap:44px;justify-content:center}
  .arrow{width:8px;height:62px;position:relative;background:linear-gradient(#d7e1de,#b9c8c3);border-radius:4px}
  .arrow::after{content:"";position:absolute;left:50%;bottom:-10px;transform:translateX(-50%);
    border:9px solid transparent;border-top:11px solid #b9c8c3;border-bottom:0}
  .arrows.in{margin-bottom:12px}.arrows.out{margin-top:4px}
  .stack{width:150px;height:210px;border-radius:10px;overflow:hidden;display:flex;flex-direction:column;
    box-shadow:0 14px 26px -12px rgba(18,35,61,.45)}
  .layer{display:grid;place-items:center;color:#fff;font:700 13px Montserrat;letter-spacing:.8px}
  .layer.cagip{flex:1;background:linear-gradient(160deg,var(--sage),var(--sage-dark))}
  .layer.entite{background:linear-gradient(160deg,var(--blue),var(--blue-dark))}
  .layer.entite.top{height:44px;flex:none;border-bottom:3px solid #fff}
  .layer.entite.full{flex:1}
  .layer.split{height:44px;flex:none;display:flex;gap:3px;background:#fff;border-bottom:3px solid #fff}
  .layer.split span{flex:1;display:grid;place-items:center;background:linear-gradient(160deg,var(--blue),var(--blue-dark));font-size:11px;letter-spacing:.3px}

  .callouts{display:flex;flex-direction:column;width:112px}
  .callouts.l{justify-content:flex-end;padding-bottom:70px}
  .callouts.l.mid{justify-content:center;padding:74px 0 0}
  .callouts.r{justify-content:flex-start;padding-top:74px}
  .callout{position:relative;background:#fff;border:1.5px solid var(--blue);border-radius:8px;padding:9px 10px;
    font:500 12.5px/1.35 Inter;color:var(--blue-dark);box-shadow:0 6px 14px -8px rgba(31,111,181,.4)}
  .callout.grey{border-color:#b3c0c8;color:#8a99a4;box-shadow:none}
  .callout::after,.callout::before{content:"";position:absolute;top:50%;transform:translateY(-50%);border:8px solid transparent}
  .callouts.l .callout::before{right:-17px;border-left:9px solid var(--blue)}
  .callouts.l .callout::after{right:-14px;border-left:9px solid #fff}
  .callouts.l .callout.grey::before{border-left-color:#b3c0c8}
  .callouts.r .callout::before{left:-17px;border-right:9px solid var(--blue)}
  .callouts.r .callout::after{left:-14px;border-right:9px solid #fff}

  /* ---------- Bullets ---------- */
  ul.pts{list-style:none;width:100%;display:flex;flex-direction:column;gap:10px;margin-top:4px}
  ul.pts li{position:relative;padding-left:20px;font-size:14px;line-height:1.45;color:var(--ink)}
  ul.pts li::before{content:"";position:absolute;left:2px;top:8px;width:8px;height:8px;border-radius:50%;
    background:var(--green);box-shadow:0 0 0 3px rgba(0,133,124,.15)}
  ul.pts b{color:var(--navy);font-weight:700}
  .col.blue ul.pts li::before{background:var(--blue);box-shadow:0 0 0 3px rgba(31,111,181,.15)}

  /* ---------- Mini diagrams (slide 2) ---------- */
  .mini{display:flex;flex-direction:column;align-items:center;margin-bottom:16px}
  .mini .arrows{gap:22px}
  .mini .arrow{width:4px;height:30px}
  .mini .arrow::after{border-width:5px;border-top-width:7px;bottom:-6px}
  .mini .arrows.in{margin-bottom:8px}
  .mini .stack{width:84px;height:100px;border-radius:7px}
  .mini .layer{font-size:8px;letter-spacing:.3px}
  .mini .layer.entite.top,.mini .layer.split{height:22px;border-bottom-width:2px}
  .mini .layer.split span{font-size:6.5px}
  .slide2 .pill{margin-bottom:18px}

  /* ---------- Footer ---------- */
  footer.legal{display:flex;justify-content:space-between;align-items:flex-end;gap:24px;margin-top:30px;padding-top:16px;border-top:1px solid var(--line)}
  footer.legal p{font-size:10.5px;line-height:1.5;color:var(--muted);max-width:760px}
  footer.legal p strong{color:var(--red);font-weight:600}
  .ca-logo{display:flex;align-items:center;gap:8px;white-space:nowrap}
  .ca-logo .mk{font:800 20px Montserrat;color:var(--green);letter-spacing:-1.5px}
  .ca-logo .mk i{font-style:normal;color:var(--red)}
  .ca-logo div{font:700 10px Montserrat;color:var(--navy);letter-spacing:.8px;line-height:1.25}

  /* ---------- Nav ---------- */
  .nav{display:flex;align-items:center;justify-content:center;gap:16px;margin-top:20px}
  .nav button{width:44px;height:44px;border-radius:50%;border:0;background:#fff;color:var(--navy);font-size:20px;cursor:pointer;
    box-shadow:0 4px 14px rgba(18,35,61,.12);transition:.2s}
  .nav button:hover{background:var(--green);color:#fff}
  .dots{display:flex;gap:8px}
  .dot{width:9px;height:9px;border-radius:50%;background:#c3d0cc;cursor:pointer;transition:.25s}
  .dot.active{width:28px;border-radius:5px;background:var(--green)}

  /* ---------- Responsive ---------- */
  @media (max-width:1100px){
    .grid{grid-template-columns:repeat(2,1fr)}
    .col::after{display:none}
  }
  @media (max-width:640px){
    .slide{padding:32px 16px 20px}
    h1{max-width:100%}
    .grid{grid-template-columns:1fr}
    .col{background:#f8fbfa;border:1px solid #e6eeeb}
    .stack{width:120px}
    .callouts{width:100px}
    footer.legal{flex-direction:column;align-items:flex-start}
  }
  @media print{
    body{background:#fff;padding:0}
    .topbar .tabs,.nav{display:none}
    .slide{display:block!important;box-shadow:none;page-break-after:always;animation:none}
  }
</style>
</head>
<body>

<header class="topbar">
  <div class="brand">
    <div class="brand-mark">CA</div>
    <div class="brand-text">Crédit Agricole<span>Group Infrastructure Platform</span></div>
  </div>
  <nav class="tabs">
    <button class="tab active" data-go="0">Vue schéma</button>
    <button class="tab" data-go="1">Vue détaillée</button>
  </nav>
</header>

<main class="stage">

<!-- ======================= SLIDE 1 ======================= -->
<section class="slide active">
  <div class="slide-num">01 / 02</div>
  <h1>Un modèle et une plateforme à <em>responsabilités partagées</em></h1>

